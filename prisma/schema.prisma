// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String        @id
  name          String
  email         String        @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime      @db.Timestamptz(3)
  updatedAt     DateTime      @db.Timestamptz(3)
  sessions      Session[]
  accounts      Account[]
  transactions  Transaction[]
  savings       Savings[]

  @@map("user")
}

model Session {
  id        String   @id
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  token     String   @unique
  expiresAt DateTime @db.Timestamptz(3)
  ipAddress String?
  userAgent String?
  createdAt DateTime @db.Timestamptz(3)
  updatedAt DateTime @db.Timestamptz(3)

  @@index([userId], map: "session_userId_idx")
  @@map("session")
}

model Account {
  id                    String    @id
  user                  User      @relation(fields: [userId], references: [id])
  userId                String
  issuer                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @db.Timestamptz(3)
  updatedAt             DateTime  @db.Timestamptz(3)

  @@index([userId], map: "account_userId_idx")
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @db.Timestamptz(3)
  updatedAt  DateTime @db.Timestamptz(3)

  @@index([identifier], map: "verification_identifier_idx")
  @@map("verification")
}

enum TransactionType {
  EXPENSE
  INCOME
}

model Transaction {
  id        String          @id @default(cuid())
  userId    String
  savingsId String?
  type      TransactionType @default(EXPENSE)
  category  String
  amount    Int
  notes     String?
  createdAt DateTime        @default(now()) @db.Timestamptz(3)

  user    User     @relation(fields: [userId], references: [id])
  savings Savings? @relation(fields: [savingsId], references: [id])

  @@index([userId, createdAt])
  @@index([savingsId])
  @@map("transaction")
}

enum SavingStatus {
  ACTIVE
  COMPLETED
  ON_HOLD
}

model Savings {
  id         String       @id @default(cuid())
  userId     String
  title      String
  goalAmount Int
  status     SavingStatus @default(ACTIVE)
  endDate    DateTime?    @db.Timestamptz(3)
  imageUrl   String?
  createdAt  DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime     @updatedAt @db.Timestamptz(3)

  user         User          @relation(fields: [userId], references: [id])
  transactions Transaction[]

  @@index([userId])
  @@map("savings")
}
